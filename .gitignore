# Visual Studio
.vs/
*.user
*.suo
*.VC.db
*.VC.opendb
*.ipch

# Build folders
out/
build/
cmake-build-*/

# CMake build folders
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Testing/
CTestTestfile.cmake
cmake_install.cmake
install_manifest.txt
compile_commands.json

# Binaries
*.exe
*.dll
*.pdb
*.ilk
*.lib
*.obj
*.exp

# Source mesh assets are OBJ files and must remain trackable.
!engine/assets/models/*.obj

# Keep DXC runtime and import library in repository
!external/dxc/lib/x64/dxcompiler.lib
!external/dxc/bin/x64/dxcompiler.dll
!external/dxc/bin/x64/dxil.dll
!external/dxc/bin/x64/dxc.exe

# Authored procedural model sources (not compiler object files).
!engine/assets/models/primitives/*.obj

# Keep local architecture notes ignored; version the lab compliance report.
/docs/*
!/docs/RenderingLab3-MaterialPipeline.md
!/docs/RenderingLab3-Demo.md

# Regenerable loader caches and runtime log.
*.wmesh
*.wtex
/engine.log

# Project OBJ meshes are authored resources, not compiler objects.
!test_projects/**/*.obj
!examples/**/*.obj
